{
  "name": "loom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Recover the exact source object, locally.",
  "repository": "https://github.com/AlisinaDevelo/LOOM",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "lint": "npm run lint:code && npm run lint:markdown",
    "lint:code": "eslint . --max-warnings=0",
    "lint:markdown": "node scripts/lint-markdown.mjs",
    "test": "vitest run && npm run test:browser-extension && npm run test:markdown-tooling",
    "test:browser-extension": "node --test browser-extension/test/capture.test.js",
    "test:markdown-tooling": "node --test scripts/lint-markdown.test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "check": "npm run lint && npm run test && npm run build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "~2.11.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "markdownlint": "0.41.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
